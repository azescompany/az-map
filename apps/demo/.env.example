VITE_APP_MODE=customer
# Shell: default (floating) | form (top toolbar, real estate)
# VITE_SHELL_VARIANT=form

# Aktiv: cdn | cdn-derived | cdn-canonical | local | derived
#   cdn / cdn-derived → jsDelivr data-derived/ pin (DEFAULT_DATA_BASE)  ← default
#   cdn-canonical     → jsDelivr fat data/ pin
#   local             → Vite publicDir = repo data/
#   derived           → Vite publicDir = repo data-derived/
VITE_GEOATLAS_DATA_BASE=cdn
VITE_GEOATLAS_DATA_LOCAL=/
VITE_GEOATLAS_DATA_CDN=https://cdn.jsdelivr.net/gh/azescompany/az-map@v0.3.2-national/data-derived/
VITE_GEOATLAS_DATA_CDN_CANONICAL=https://cdn.jsdelivr.net/gh/azescompany/az-map@v0.3.2-national/data/
# L2 Service Worker: unset = on in production only; 1 = always; 0 = off
# VITE_GEOATLAS_SW=1
